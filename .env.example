# ─────────────────────────────────────────────────────────────────────────────
# Inventario Pro — configuración de PRODUCCIÓN (docker compose)
# Copia este archivo como .env y completa los valores. Nunca subas .env a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos y caché (OBLIGATORIO) ─────────────────────────────────────
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia-esta-clave-larga
REDIS_PASSWORD=cambia-esta-otra-clave

# ── URL pública (OBLIGATORIO) ───────────────────────────────────────────────
# Dirección con la que los usuarios abren el sistema. Varias separadas por coma.
# Ej. red local: http://192.168.1.50   ·   nube: https://inventario.miempresa.com
WEB_URL=http://localhost
# true si el sitio se sirve por HTTPS (marca la cookie de sesión como segura)
COOKIE_SECURE=false

# ── Seguridad (OBLIGATORIO) ─────────────────────────────────────────────────
# Genera el par de claves con:
#   openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# y pégalas en una sola línea reemplazando los saltos de línea por \n
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# 64 caracteres hexadecimales: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Empresa y administrador inicial (se crean en el primer arranque) ────────
INITIAL_COMPANY_NAME="Mi Cadena S.A.S."
INITIAL_BRANCH_NAME="Sede principal"
INITIAL_ADMIN_NAME="Administrador General"
INITIAL_ADMIN_EMAIL=admin@miempresa.com
INITIAL_ADMIN_PASSWORD=CambiaEsta123
INITIAL_CURRENCY=COP

# ── Zona horaria y tareas programadas ───────────────────────────────────────
TZ=America/Bogota
JOBS_ENABLED=true
# Copia de seguridad automática diaria (02:00) de cada empresa
BACKUP_SCHEDULE_ENABLED=true

# ── Correo (recuperación de contraseña) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Inventario Pro <no-reply@miempresa.com>"

# ── Archivos: local (volumen Docker) o S3/MinIO/R2 ──────────────────────────
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_MB=50
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ── Asistente con IA (opcional) ─────────────────────────────────────────────
# Sin clave, el asistente responde con reglas sobre tus datos (funciona sin internet).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Puertos expuestos por nginx ─────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
RATE_LIMIT_MAX=300
