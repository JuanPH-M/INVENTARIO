# ─────────────────────────────────────────────────────────────────────────────
# Inventario Pro — configuración de DESARROLLO de la API
# Copia este archivo como apps/api/.env
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# PostgreSQL local (o el de docker-compose.dev.yml)
DATABASE_URL="postgresql://inventario:inventario_dev@localhost:5432/inventario_dev?schema=public"

# Redis es opcional: si no está disponible la API usa caché en memoria
REDIS_URL=redis://:inventario_redis@localhost:6379

# En desarrollo puedes dejar las claves RSA vacías: se usa HS256 con JWT_DEV_SECRET
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_DEV_SECRET=cambia-este-secreto-de-desarrollo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=

# Correo: Mailhog (docker-compose.dev.yml) → bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Inventario Pro <no-reply@inventario.local>"

STORAGE_DRIVER=local
STORAGE_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=50

TZ=America/Bogota
JOBS_ENABLED=true
BACKUP_SCHEDULE_ENABLED=false

# Super administrador de la plataforma (solo seeds de desarrollo)
SUPER_ADMIN_EMAIL=admin@inventario.dev
SUPER_ADMIN_PASSWORD=Admin123!

# Opcional: asistente con Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
