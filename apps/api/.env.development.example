# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees el archivo .env con valores reales.
# Genera las claves RSA con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
MFA_APP_NAME=Inventario SaaS
SUPER_ADMIN_EMAIL=admin@inventario.dev

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ─────────────────────────────────────────────────────────────────
# Redis no está instalado localmente — usar URL dummy; el módulo de cache fallará gracefully
REDIS_URL=redis://localhost:6379
REDIS_TTL_DEFAULT=300

# ─── JWT (RS256) ────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION

# ─── Storage (local) ────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_SIZE_MB=50

# ─── Email (Mailhog dev) ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@inventario.dev

# ─── AWS S3 (opcional — solo si STORAGE_PROVIDER=s3) ────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

