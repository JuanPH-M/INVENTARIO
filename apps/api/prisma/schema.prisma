  nextMaintenance       DateTime? @map("next_maintenance") @db.Date
  maintenanceIntervalDays Int?    @map("maintenance_interval_days")
  location              String?   @db.VarChar(255)
  responsibleId         String?   @map("responsible_id")
  images                Json      @default("[]")
  documents             Json      @default("[]")
  notes                 String?
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id])
  maintenances AssetMaintenance[]

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, status])
  @@index([tenantId, nextMaintenance])
  @@map("assets")
}

model AssetMaintenance {
  id            String    @id @default(uuid())
  assetId       String    @map("asset_id")
  type          String    @db.VarChar(50)
  description   String
  cost          Decimal?  @db.Decimal(15, 4)
  performedById String?   @map("performed_by_id")
  performedAt   DateTime  @default(now()) @map("performed_at")
  nextScheduled DateTime? @map("next_scheduled") @db.Date
  documents     Json      @default("[]")
  createdAt     DateTime  @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("asset_maintenances")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 17: INCIDENCIAS
// ═════════════════════════════════════════════════════════════

model Incident {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  branchId         String    @map("branch_id")
  ticketNumber     String    @map("ticket_number") @db.VarChar(50)
  title            String    @db.VarChar(500)
  description      String
  type             String    @db.VarChar(50)
  severity         String    @default("medium") @db.VarChar(20)
  status           String    @default("open") @db.VarChar(30)
  reportedById     String    @map("reported_by_id")
  assignedToId     String?   @map("assigned_to_id")
  occurredAt       DateTime  @map("occurred_at")
  resolvedAt       DateTime? @map("resolved_at")
  resolution       String?
  resolutionCost   Decimal?  @map("resolution_cost") @db.Decimal(15, 4)
  affectedAssets   Json      @default("[]") @map("affected_assets")
  affectedProducts Json      @default("[]") @map("affected_products")
  images           Json      @default("[]")
  documents        Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  reportedBy User      @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedTo User?     @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  comments   IncidentComment[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, status])
  @@map("incidents")
}

model IncidentComment {
  id          String   @id @default(uuid())
  incidentId  String   @map("incident_id")
  content     String
  createdById String   @map("created_by_id")
  isInternal  Boolean  @default(false) @map("is_internal")
  createdAt   DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_comments")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 18: NOTIFICACIONES
// ═════════════════════════════════════════════════════════════

model Notification {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  type          String    @db.VarChar(100)
  title         String    @db.VarChar(500)
  body          String?
  channel       String    @default("in_app") @db.VarChar(20)
  status        String    @default("unread") @db.VarChar(20)
  priority      String    @default("normal") @db.VarChar(20)
  referenceType String?   @map("reference_type") @db.VarChar(50)
  referenceId   String?   @map("reference_id")
  metadata      Json      @default("{}")
  sentAt        DateTime  @default(now()) @map("sent_at")
  readAt        DateTime? @map("read_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, status])
  @@index([tenantId])
  @@index([sentAt(sort: Desc)])
  @@map("notifications")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 19: REPORTES GENERADOS
// ═════════════════════════════════════════════════════════════

model GeneratedReport {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  type        String   @db.VarChar(100)
  title       String   @db.VarChar(500)
  periodType  String?  @map("period_type") @db.VarChar(20)
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  fileUrl     String   @map("file_url")
  fileSize    Int      @default(0) @map("file_size")
  status      String   @default("completed") @db.VarChar(20)
  generatedById String? @map("generated_by_id")
  generatedAt DateTime @default(now()) @map("generated_at")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, periodStart(sort: Desc)])
  @@map("generated_reports")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 20: AUDITORÍA
// ═════════════════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  userId       String?  @map("user_id")
  userEmail    String?  @map("user_email") @db.VarChar(255)
  action       String   @db.VarChar(100)
  module       String   @db.VarChar(100)
  entity       String   @db.VarChar(100)
  entityId     String?  @map("entity_id") @db.VarChar(255)
  changes      Json?
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  result       String   @default("success") @db.VarChar(20)
  errorMessage String?  @map("error_message")
  occurredAt   DateTime @default(now()) @map("occurred_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, action])
  @@index([tenantId, module])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 21: INTELIGENCIA ARTIFICIAL
// ═════════════════════════════════════════════════════════════

model AiPrediction {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  branchId      String?  @map("branch_id")
  productId     String?  @map("product_id")
  type          String   @db.VarChar(50)
  prediction    Json
  confidence    Decimal? @db.Decimal(5, 4)
  validFrom     DateTime @map("valid_from")
  validUntil    DateTime @map("valid_until")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@index([productId])
  @@map("ai_predictions")
}

model AiConversation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  messages AiMessage[]

  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   @db.VarChar(20)
  content        String
  tokensUsed     Int?     @map("tokens_used")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 22: BACKUPS
// ═════════════════════════════════════════════════════════════

model BackupRecord {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  type        String    @default("full") @db.VarChar(20)
  status      String    @default("pending") @db.VarChar(20)
  fileUrl     String?   @map("file_url")
  fileSize    BigInt?   @map("file_size")
  checksum    String?   @db.VarChar(64)
  isEncrypted Boolean   @default(true) @map("is_encrypted")
  notes       String?
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @map("expires_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("backup_records")
}
