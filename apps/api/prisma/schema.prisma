  parentId  String?   @map("parent_id")
  code      String?   @db.VarChar(50)
  name      String    @db.VarChar(255)
  type      String    @db.VarChar(50)
  balance   Decimal   @default(0) @db.Decimal(15, 4)
  currency  String    @default("COP") @db.VarChar(3)
