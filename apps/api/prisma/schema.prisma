// ─────────────────────────────────────────────────────────────────────────────
// INVENTARIO SAAS — PRISMA SCHEMA COMPLETO
// 48 modelos | PostgreSQL 16 | Prisma 6.x
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 1: PLATAFORMA SAAS
// ═════════════════════════════════════════════════════════════

model SaasPlan {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  priceMonthly   Decimal  @default(0) @db.Decimal(10, 4) @map("price_monthly")
  priceAnnual    Decimal  @default(0) @db.Decimal(10, 4) @map("price_annual")
  currency       String   @default("USD") @db.VarChar(3)
  maxBranches    Int      @default(2)  @map("max_branches")
  maxUsers       Int      @default(5)  @map("max_users")
  maxProducts    Int      @default(1000) @map("max_products")
  maxStorageGb   Int      @default(5)  @map("max_storage_gb")
  features       Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0)  @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt    @map("updated_at")

  tenants           Tenant[]
  saasSubscriptions SaasSubscription[]

  @@map("saas_plans")
}

model SaasSubscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique @map("tenant_id")
  planId               String    @map("plan_id")
  status               String    @default("active") @db.VarChar(20)
  billingCycle         String    @map("billing_cycle") @db.VarChar(20)
  startedAt            DateTime  @map("started_at")
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  plan   SaasPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("saas_subscriptions")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 2: TENANTS (EMPRESAS)
// ═════════════════════════════════════════════════════════════

model Tenant {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(100)
  legalName   String?   @map("legal_name") @db.VarChar(255)
  taxId       String?   @map("tax_id") @db.VarChar(50)
  email       String    @db.VarChar(255)
  phone       String?   @db.VarChar(50)
  address     Json?
  logoUrl     String?   @map("logo_url")
  settings    Json      @default("{}")
  status      String    @default("active") @db.VarChar(20)
  planId      String    @map("plan_id")
  trialEndsAt DateTime? @map("trial_ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  plan               SaasPlan         @relation(fields: [planId], references: [id])
  saasSubscription   SaasSubscription?
  users              User[]
  roles              Role[]
  branches           Branch[]
  categories         Category[]
  suppliers          Supplier[]
  products           Product[]
  inventoryStock     InventoryStock[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  sales              Sale[]
  financialAccounts  FinancialAccount[]
  financialTxs       FinancialTransaction[]
  clients            Client[]
  documents          Document[]
  cashRegisters      CashRegister[]
  currencies         TenantCurrency[]
  clientSubscriptions ClientSubscription[]
  calendarEvents     CalendarEvent[]
  assets             Asset[]
  incidents          Incident[]
  notifications      Notification[]
  generatedReports   GeneratedReport[]
  auditLogs          AuditLog[]
  aiPredictions      AiPrediction[]
  aiConversations    AiConversation[]
  backupRecords      BackupRecord[]

  @@index([slug])
  @@index([status])
  @@index([planId])
  @@map("tenants")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 3: IDENTIDAD Y ACCESO
// ═════════════════════════════════════════════════════════════

model User {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  email                String    @db.VarChar(255)
  emailVerifiedAt      DateTime? @map("email_verified_at")
  passwordHash         String    @map("password_hash")
  firstName            String    @map("first_name") @db.VarChar(100)
  lastName             String    @map("last_name") @db.VarChar(100)
  phone                String?   @db.VarChar(50)
  avatarUrl            String?   @map("avatar_url")
  status               String    @default("active") @db.VarChar(20)
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  lastLoginAt          DateTime? @map("last_login_at")
  lastLoginIp          String?   @map("last_login_ip") @db.VarChar(45)
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  mfaSecret            String?   @map("mfa_secret")
  mfaBackupCodes       String[]  @map("mfa_backup_codes")
  language             String    @default("es") @db.VarChar(10)
  timezone             String    @default("America/Bogota") @db.VarChar(50)
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt      @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  userPermissions UserPermission[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  clientNotes     ClientNote[]
  managedBranches Branch[]        @relation("BranchManager")
  cashRegisterSessions CashRegisterSession[] @relation("SessionOpenedBy")
  closedSessions  CashRegisterSession[]     @relation("SessionClosedBy")
  incidentsReported Incident[]    @relation("IncidentReporter")
  incidentsAssigned Incident[]    @relation("IncidentAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([slug])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String?  @map("granted_by")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  branchId   String?   @map("branch_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_roles")
}

model UserPermission {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  branchId     String?   @map("branch_id")
  granted      Boolean   @default(true)
  grantedBy    String?   @map("granted_by")
  grantedAt    DateTime  @default(now()) @map("granted_at")
  expiresAt    DateTime? @map("expires_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id])

  @@unique([userId, permissionId, branchId])
  @@map("user_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceInfo Json?     @map("device_info")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 4: ESTRUCTURA EMPRESARIAL
// ═════════════════════════════════════════════════════════════

model Branch {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String    @db.VarChar(255)
  code      String?   @db.VarChar(50)
  type      String    @default("physical") @db.VarChar(50)
  address   Json?
  phone     String?   @db.VarChar(50)
  email     String?   @db.VarChar(255)
  managerId String?   @map("manager_id")
  settings  Json      @default("{}")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  manager          User?             @relation("BranchManager", fields: [managerId], references: [id])
  userRoles        UserRole[]
  userPermissions  UserPermission[]
  inventoryStock   InventoryStock[]
  inMovements      InventoryMovement[] @relation("MovementToBranch")
  outMovements     InventoryMovement[] @relation("MovementFromBranch")
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  cashRegisters    CashRegister[]
  financialAccounts FinancialAccount[]
  financialTxs     FinancialTransaction[]
  assets           Asset[]
  incidents        Incident[]
  calendarEvents   CalendarEvent[]
  clientSubscriptions ClientSubscription[]
  documents        Document[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 5: DIVISAS (MULTI CURRENCY)
// ═════════════════════════════════════════════════════════════

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(3)
  name          String   @db.VarChar(100)
  symbol        String   @db.VarChar(10)
  decimalPlaces Int      @default(2) @map("decimal_places")
  isBase        Boolean  @default(false) @map("is_base")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenantCurrencies TenantCurrency[]
  fromRates        ExchangeRate[]   @relation("FromCurrency")
  toRates          ExchangeRate[]   @relation("ToCurrency")
  sales            Sale[]
  purchaseOrders   PurchaseOrder[]

  @@map("currencies")
}

model TenantCurrency {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  currencyId String   @map("currency_id")
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([tenantId, currencyId])
  @@map("tenant_currencies")
}

model ExchangeRate {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  fromCurrencyId   String   @map("from_currency_id")
  toCurrencyId     String   @map("to_currency_id")
  rate             Decimal  @db.Decimal(18, 8)
  inverseRate      Decimal  @map("inverse_rate") @db.Decimal(18, 8)
  source           String   @default("manual") @db.VarChar(50)
  effectiveDate    DateTime @map("effective_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([tenantId, fromCurrencyId, toCurrencyId, effectiveDate])
  @@map("exchange_rates")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 6: CLIENTES
// ═════════════════════════════════════════════════════════════

model Client {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  type             String    @default("individual") @db.VarChar(20)
  status           String    @default("active") @db.VarChar(20)
  firstName        String?   @map("first_name") @db.VarChar(100)
  lastName         String?   @map("last_name") @db.VarChar(100)
  businessName     String?   @map("business_name") @db.VarChar(255)
  idType           String    @map("id_type") @db.VarChar(20)
  idNumber         String    @map("id_number") @db.VarChar(100)
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(50)
  birthDate        DateTime? @map("birth_date") @db.Date
  creditLimit      Decimal   @default(0) @map("credit_limit") @db.Decimal(15, 4)
  creditBalance    Decimal   @default(0) @map("credit_balance") @db.Decimal(15, 4)
  totalPurchases   Decimal   @default(0) @map("total_purchases") @db.Decimal(15, 4)
  totalSales       Decimal   @default(0) @map("total_sales") @db.Decimal(15, 4)
  lastActivityAt   DateTime? @map("last_activity_at")
  notes            String?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  addresses ClientAddress[]
  documents ClientDocument[]
  contacts  ClientContact[]
  clientNotes ClientNote[]
  sales     Sale[]
  purchaseOrders PurchaseOrder[]
  contractDocuments Document[]

  @@unique([tenantId, idType, idNumber])
  @@index([tenantId])
  @@index([tenantId, idNumber])
  @@index([tenantId, status])
  @@map("clients")
}

model ClientAddress {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  label     String   @default("Principal") @db.VarChar(100)
  street    String   @db.VarChar(500)
  city      String   @db.VarChar(100)
  state     String?  @db.VarChar(100)
  country   String   @default("Colombia") @db.VarChar(100)
  zip       String?  @db.VarChar(20)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

model ClientDocument {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  type        String    @db.VarChar(50)
  number      String    @db.VarChar(100)
  issueDate   DateTime? @map("issue_date") @db.Date
  expiryDate  DateTime? @map("expiry_date") @db.Date
  fileUrl     String?   @map("file_url")
  verifiedAt  DateTime? @map("verified_at")
  verifiedBy  String?   @map("verified_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_documents")
}

model ClientContact {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  name      String   @db.VarChar(255)
  position  String?  @db.VarChar(100)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model ClientNote {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  content     String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([clientId])
  @@map("client_notes")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 7: DOCUMENTOS
// ═════════════════════════════════════════════════════════════

model Document {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  branchId       String?   @map("branch_id")
  clientId       String?   @map("client_id")
  type           String    @db.VarChar(50)
  status         String    @default("active") @db.VarChar(30)
  title          String    @db.VarChar(500)
  description    String?
  fileUrl        String    @map("file_url")
  fileSize       Int       @default(0) @map("file_size")
  mimeType       String    @default("application/pdf") @map("mime_type") @db.VarChar(100)
  checksum       String    @db.VarChar(64)
  referenceType  String?   @map("reference_type") @db.VarChar(50)
  referenceId    String?   @map("reference_id") @db.VarChar(255)
  expiresAt      DateTime? @map("expires_at")
  currentVersion Int       @default(1) @map("current_version")
  metadata       Json      @default("{}")
  uploadedById   String    @map("uploaded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  client      Client?             @relation(fields: [clientId], references: [id])
  signatories DocumentSignatory[]
  versions    DocumentVersion[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([referenceType, referenceId])
  @@index([clientId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  version      Int
  fileUrl      String   @map("file_url")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  checksum     String   @db.VarChar(64)
  uploadedById String   @map("uploaded_by_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentSignatory {
  id           String    @id @default(uuid())
  documentId   String    @map("document_id")
  name         String    @db.VarChar(255)
  email        String?   @db.VarChar(255)
  signedAt     DateTime? @map("signed_at")
  signatureUrl String?   @map("signature_url")
  order        Int       @default(1)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_signatories")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 8: CATÁLOGO
// ═════════════════════════════════════════════════════════════

model Category {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  parentId    String?   @map("parent_id")
  name        String    @db.VarChar(255)
  slug        String    @db.VarChar(255)
  description String?
  icon        String?   @db.VarChar(100)
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]
  assets   Asset[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@map("categories")
}

model Supplier {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  name         String    @db.VarChar(255)
  legalName    String?   @map("legal_name") @db.VarChar(255)
  taxId        String?   @map("tax_id") @db.VarChar(50)
  contactName  String?   @map("contact_name") @db.VarChar(255)
  email        String?   @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  address      Json?
  website      String?   @db.VarChar(500)
  paymentTerms Int       @default(30) @map("payment_terms")
  currency     String    @default("COP") @db.VarChar(3)
  notes        String?
  status       String    @default("active") @db.VarChar(20)
  documents    Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

model Product {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  categoryId       String?   @map("category_id")
  supplierId       String?   @map("supplier_id")
  internalCode     String?   @map("internal_code") @db.VarChar(100)
  barcode          String?   @db.VarChar(100)
  qrCode           String?   @map("qr_code") @db.VarChar(500)
  sku              String?   @db.VarChar(100)
  name             String    @db.VarChar(500)
  description      String?
  shortDescription String?   @map("short_description") @db.VarChar(500)
  brand            String?   @db.VarChar(200)
  model            String?   @db.VarChar(200)
  type             String    @default("physical") @db.VarChar(50)
  status           String    @default("active") @db.VarChar(20)
  costPrice        Decimal   @default(0) @map("cost_price") @db.Decimal(15, 4)
  salePrice        Decimal   @default(0) @map("sale_price") @db.Decimal(15, 4)
  minSalePrice     Decimal   @default(0) @map("min_sale_price") @db.Decimal(15, 4)
  unitOfMeasure    String    @default("unit") @map("unit_of_measure") @db.VarChar(50)
  trackInventory   Boolean   @default(true) @map("track_inventory")
  minStock         Decimal   @default(0) @map("min_stock") @db.Decimal(15, 4)
  maxStock         Decimal?  @map("max_stock") @db.Decimal(15, 4)
  reorderPoint     Decimal   @default(0) @map("reorder_point") @db.Decimal(15, 4)
  weight           Decimal?  @db.Decimal(10, 4)
  dimensions       Json?
  taxRate          Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxIncluded      Boolean   @default(false) @map("tax_included")
  images           Json      @default("[]")
  documents        Json      @default("[]")
  metadata         Json      @default("{}")
  defaultLocation  String?   @map("default_location") @db.VarChar(200)
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  category       Category?           @relation(fields: [categoryId], references: [id])
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  jewelryDetails ProductJewelryDetail?
  inventoryStock InventoryStock[]
  movements      InventoryMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseOrderItem[]
  productEvents  ProductEvent[]

  @@unique([tenantId, internalCode])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([categoryId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("products")
}

model ProductJewelryDetail {
  id                String    @id @default(uuid())
  productId         String    @unique @map("product_id")
  tenantId          String    @map("tenant_id")
  material          String?   @db.VarChar(100)
  karat             Decimal?  @db.Decimal(5, 2)
  weightGrams       Decimal?  @map("weight_grams") @db.Decimal(10, 4)
  weightTroyOz      Decimal?  @map("weight_troy_oz") @db.Decimal(10, 6)
  stones            Json      @default("[]")
  certificateNumber String?   @map("certificate_number") @db.VarChar(200)
  certificateType   String?   @map("certificate_type") @db.VarChar(100)
  certificateUrl    String?   @map("certificate_url")
  appraisedValue    Decimal?  @map("appraised_value") @db.Decimal(15, 4)
  appraisedAt       DateTime? @map("appraised_at")
  appraiserName     String?   @map("appraiser_name") @db.VarChar(255)
  appraisalDocument String?   @map("appraisal_document")
  provenance        String?
  hallmarks         String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_jewelry_details")
}

model ProductEvent {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  tenantId      String   @map("tenant_id")
  type          String   @db.VarChar(50)
  description   String   @db.VarChar(1000)
  metadata      Json     @default("{}")
  performedById String?  @map("performed_by_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([tenantId, productId, occurredAt])
  @@map("product_events")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 9: INVENTARIO
// ═════════════════════════════════════════════════════════════

model InventoryStock {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  productId      String    @map("product_id")
  branchId       String    @map("branch_id")
  quantity       Decimal   @default(0) @db.Decimal(15, 4)
  reserved       Decimal   @default(0) @db.Decimal(15, 4)
  location       String?   @db.VarChar(200)
  binCode        String?   @map("bin_code") @db.VarChar(100)
  lastCountedAt  DateTime? @map("last_counted_at")
  lastCountedById String?  @map("last_counted_by_id")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([tenantId, productId, branchId])
  @@index([tenantId])
  @@index([productId])
  @@index([branchId])
  @@map("inventory_stock")
}

model InventoryMovement {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  productId     String   @map("product_id")
  branchId      String   @map("branch_id")
  type          String   @db.VarChar(50)
  quantity      Decimal  @db.Decimal(15, 4)
  direction     Int      @db.SmallInt
  stockBefore   Decimal  @map("stock_before") @db.Decimal(15, 4)
  stockAfter    Decimal  @map("stock_after") @db.Decimal(15, 4)
  unitCost      Decimal? @map("unit_cost") @db.Decimal(15, 4)
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   String?  @map("reference_id")
  fromBranchId  String?  @map("from_branch_id")
  toBranchId    String?  @map("to_branch_id")
  notes         String?
  documents     Json     @default("[]")
  performedById String   @map("performed_by_id")
  performedAt   DateTime @default(now()) @map("performed_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  branch     Branch  @relation("MovementToBranch", fields: [branchId], references: [id])
  fromBranch Branch? @relation("MovementFromBranch", fields: [fromBranchId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([branchId])
  @@index([tenantId, type])
  @@index([tenantId, performedAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 10: CAJA REGISTRADORA
// ═════════════════════════════════════════════════════════════

model CashRegister {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  branchId  String    @map("branch_id")
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  branch   Branch                @relation(fields: [branchId], references: [id])
  sessions CashRegisterSession[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId])
  @@index([branchId])
  @@map("cash_registers")
}

model CashRegisterSession {
  id                    String    @id @default(uuid())
  cashRegisterId        String    @map("cash_register_id")
  tenantId              String    @map("tenant_id")
  branchId              String    @map("branch_id")
  openedById            String    @map("opened_by_id")
  closedById            String?   @map("closed_by_id")
  openedAt              DateTime  @default(now()) @map("opened_at")
  closedAt              DateTime? @map("closed_at")
  openingAmount         Decimal   @map("opening_amount") @db.Decimal(15, 4)
  expectedClosingAmount Decimal   @default(0) @map("expected_closing_amount") @db.Decimal(15, 4)
  actualClosingAmount   Decimal?  @map("actual_closing_amount") @db.Decimal(15, 4)
  difference            Decimal?  @db.Decimal(15, 4)
  status                String    @default("open") @db.VarChar(20)
  notes                 String?

  cashRegister CashRegister          @relation(fields: [cashRegisterId], references: [id])
  openedBy     User                  @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedBy     User?                 @relation("SessionClosedBy", fields: [closedById], references: [id])
  movements    CashRegisterMovement[]
  sales        Sale[]

  @@index([tenantId])
  @@index([branchId])
  @@index([cashRegisterId, status])
  @@map("cash_register_sessions")
}

model CashRegisterMovement {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  type            String   @db.VarChar(30)
  amount          Decimal  @db.Decimal(15, 4)
  description     String   @db.VarChar(500)
  referenceType   String?  @map("reference_type") @db.VarChar(50)
  referenceId     String?  @map("reference_id")
  performedById   String   @map("performed_by_id")
  performedAt     DateTime @default(now()) @map("performed_at")

  session CashRegisterSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("cash_register_movements")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 11: COMPRAS
// ═════════════════════════════════════════════════════════════

model PurchaseOrder {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  branchId        String    @map("branch_id")
  supplierId      String    @map("supplier_id")
  clientId        String?   @map("client_id")
  currencyId      String    @default("") @map("currency_id")
  exchangeRate    Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  orderNumber     String    @map("order_number") @db.VarChar(50)
  status          String    @default("draft") @db.VarChar(30)
  subtotal        Decimal   @default(0) @db.Decimal(15, 4)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 4)
  discount        Decimal   @default(0) @db.Decimal(15, 4)
  total           Decimal   @default(0) @db.Decimal(15, 4)
  paymentTerms    Int?      @map("payment_terms")
  paymentStatus   String    @default("pending") @map("payment_status") @db.VarChar(30)
  expectedDate    DateTime? @map("expected_date") @db.Date
  receivedDate    DateTime? @map("received_date") @db.Date
  notes           String?
  documents       Json      @default("[]")
  images          Json      @default("[]")
  contractUrl     String?   @map("contract_url")
  contractSigned  Boolean   @default(false) @map("contract_signed")
  createdById     String?   @map("created_by_id")
  approvedById    String?   @map("approved_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  branch   Branch              @relation(fields: [branchId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  client   Client?             @relation(fields: [clientId], references: [id])
  currency Currency            @relation(fields: [currencyId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  productId        String   @map("product_id")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(15, 4)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(15, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(15, 4)
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  discountRate     Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 4)
  subtotal         Decimal  @db.Decimal(15, 4)
  location         String?  @db.VarChar(200)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ═════════════════════════════════════════════════════════════
// GRUPO 12: VENTAS
// ═════════════════════════════════════════════════════════════

model Sale {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  branchId             String    @map("branch_id")
  clientId             String?   @map("client_id")
  currencyId           String    @map("currency_id")
  exchangeRate         Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  cashRegisterSessionId String?  @map("cash_register_session_id")
  saleNumber           String    @map("sale_number") @db.VarChar(50)
  type                 String    @default("sale") @db.VarChar(30)
  status               String    @default("completed") @db.VarChar(30)
  customerName         String?   @map("customer_name") @db.VarChar(255)
  customerIdType       String?   @map("customer_id_type") @db.VarChar(50)
  customerIdNum        String?   @map("customer_id_num") @db.VarChar(100)
  customerEmail        String?   @map("customer_email") @db.VarChar(255)
  customerPhone        String?   @map("customer_phone") @db.VarChar(50)
  subtotal             Decimal   @default(0) @db.Decimal(15, 4)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 4)
  discount             Decimal   @default(0) @db.Decimal(15, 4)
  total                Decimal   @default(0) @db.Decimal(15, 4)
  amountPaid           Decimal   @default(0) @map("amount_paid") @db.Decimal(15, 4)
  changeGiven          Decimal   @default(0) @map("change_given") @db.Decimal(15, 4)
  notes                String?
  contractUrl          String?   @map("contract_url")
  contractSigned       Boolean   @default(false) @map("contract_signed")
  documents            Json      @default("[]")
  images               Json      @default("[]")
  soldById             String    @map("sold_by_id")
  voidedById           String?   @map("voided_by_id")
  voidedAt             DateTime? @map("voided_at")
  voidReason           String?   @map("void_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  branch              Branch              @relation(fields: [branchId], references: [id])
  client              Client?             @relation(fields: [clientId], references: [id])
  currency            Currency            @relation(fields: [currencyId], references: [id])
  cashRegisterSession CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
  items               SaleItem[]
  payments            PaymentTransaction[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([soldById])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, customerIdNum])
  @@index([clientId])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  productName String   @map("product_name") @db.VarChar(500)
  productCode String?  @map("product_code") @db.VarChar(100)
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 4)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  discount    Decimal  @default(0) @db.Decimal(15, 4)
  subtotal    Decimal  @db.Decimal(15, 4)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model PaymentTransaction {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  saleId      String?  @map("sale_id")
  type        String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(15, 4)
  currency    String   @default("COP") @db.VarChar(3)
  reference   String?  @db.VarChar(200)
  status      String   @default("completed") @db.VarChar(20)
  processedAt DateTime @default(now()) @map("processed_at")
  processedById String? @map("processed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  sale Sale? @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([tenantId])
  @@map("payment_transactions")
}

