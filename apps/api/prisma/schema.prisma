  internalCode          String?   @map("internal_code") @db.VarChar(100)
  serialNumber          String?   @map("serial_number") @db.VarChar(200)
  brand                 String?   @db.VarChar(200)
  model                 String?   @db.VarChar(200)
  status                String    @default("active") @db.VarChar(30)
  acquisitionDate       DateTime  @map("acquisition_date") @db.Date
  acquisitionCost       Decimal   @map("acquisition_cost") @db.Decimal(15, 4)
  currentValue          Decimal?  @map("current_value") @db.Decimal(15, 4)
  depreciationMethod    String    @default("straight_line") @map("depreciation_method") @db.VarChar(30)
