{
  "name": "inventario-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Inventario Pro — Plataforma de inventario, ventas y finanzas para negocios con una o muchas sedes",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@inventario/api --filter=@inventario/web",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @inventario/api test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo run clean",
    "db:migrate": "pnpm --filter @inventario/api exec prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @inventario/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @inventario/api prisma:seed",
    "db:studio": "pnpm --filter @inventario/api exec prisma studio",
    "db:generate": "pnpm --filter @inventario/api exec prisma generate",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "setup": "pnpm install && pnpm --filter @inventario/api exec prisma generate && pnpm db:migrate:prod && pnpm db:seed",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4",
  "author": "JuanPH-M",
  "license": "SEE LICENSE IN LICENSE"
}
