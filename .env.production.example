# ─────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT EXAMPLE
# Copy to .env.production and fill with real values
# NEVER commit .env.production to git
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
APP_PORT=3001
APP_URL=https://api.yourapp.com
WEB_URL=https://app.yourapp.com

# Database (use strong passwords)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Redis (use strong password)
REDIS_URL=redis://:STRONG_PASSWORD@redis:6379
REDIS_TTL_DEFAULT=300

# JWT (generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=MINIMUM_64_CHARS_RANDOM_STRING_HERE

# Encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY=YOUR_64_HEX_CHARS_KEY_HERE
ENCRYPTION_IV_LENGTH=16

# Email (production SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
SMTP_FROM="Inventario SaaS <noreply@yourapp.com>"

# Storage
STORAGE_DRIVER=s3
STORAGE_MAX_FILE_SIZE_MB=100

# S3 or compatible
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_ENDPOINT=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# MFA
MFA_APP_NAME="Your Company Name"

# Backup
BACKUP_PATH=/backups
BACKUP_ENCRYPTION_KEY=STRONG_BACKUP_ENCRYPTION_KEY

# Superadmin (only used on first seed)
SUPER_ADMIN_EMAIL=superadmin@yourapp.com
SUPER_ADMIN_PASSWORD=STRONG_PASSWORD_HERE
